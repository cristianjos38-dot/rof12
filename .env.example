MODEL_MODE=mock
APP_ENV=local
DOCUMENT_STORAGE_ROOT=/var/lib/rof12/documents
JWT_SECRET=replace-with-a-random-secret
JWT_ISSUER=rof12-auth
JWT_AUDIENCE=rof12-api
JWT_ALGORITHM=HS256
DATABASE_URL=postgresql+psycopg://rof12_app:rof12_app_dev_only@localhost:5432/rof12
ROF12_OWNER_PASSWORD=rof12_owner_dev_only
ROF12_APP_PASSWORD=rof12_app_dev_only
ROF12_EXECUTOR_PASSWORD=rof12_executor_dev_only
ROF12_AUDIT_PASSWORD=rof12_audit_dev_only

